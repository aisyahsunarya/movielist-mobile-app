generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Movie {
  id          Int      @id @default(autoincrement())
  title       String
  genre       String
  releaseYear Int
  rating      Float?
  description String   @db.Text
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}